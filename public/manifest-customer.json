{
  "name": "MYVIBES - Discover Restaurants & Events",
  "short_name": "MYVIBES",
  "description": "Discover the best restaurants, bars, and events near you. Get exclusive deals, earn loyalty points, and find your next vibe.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#06b6d4",
  "orientation": "portrait-primary",
  "categories": ["food", "entertainment", "lifestyle", "social"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/app/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Find Restaurants",
      "short_name": "Restaurants",
      "description": "Discover nearby restaurants",
      "url": "/app"
    },
    {
      "name": "Events Near Me",
      "short_name": "Events",
      "description": "Find local events and entertainment",
      "url": "/app?tab=events"
    },
    {
      "name": "My Points",
      "short_name": "Points",
      "description": "View your loyalty points and rewards",
      "url": "/app?tab=profile"
    }
  ]
}