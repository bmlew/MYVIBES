@"
# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.log

# Production
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Supabase
.supabase/
supabase/.branches
supabase/.temp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.cache
.parcel-cache
*.local

# Vercel
.vercel

# System Files
Thumbs.db
"@ | Out-File -FilePath .gitignore -Encoding UTF8 -NoNewline